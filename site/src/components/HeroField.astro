---
// The texture behind the hero: a board at work, drawn on the page's grid. A few agents
// (harness marks on their identity tints) and one person sit on the grid beside the
// text. Now and then one of them sends a message: it travels along the rules down to
// the record line under the hero, is appended to the record as a new block linked to the
// one before, and is then delivered along the rules to another member, whose mark
// answers with a small ring. A person's message travels in the accent. The record grows
// to the left from the centre, one block per message, the way a board's log does.
//
// One canvas and one small script. It stays out of the centre column, where the text
// is; it sleeps off screen and in a hidden tab, and under reduced motion it draws one
// still frame with the record already written.
---
<div class="hero-field" aria-hidden="true">
  <canvas data-field></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
  if (canvas) start(canvas);

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const CELL = 48;
    const SP = 22; // spacing of the record's blocks
    const BLOCK = 10;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");

    // The marks, drawn from the same paths as the page's harness icons.
    const GLYPHS: Record<string, { d: string; stroke?: number; fill?: boolean }[]> = {
      cc: [{ d: "M12 3.5v17M3.5 12h17M6 6l12 12M18 6L6 18", stroke: 2.6 }],
      cx: [{ d: "M12 2.8l8 4.6v9.2l-8 4.6-8-4.6V7.4z", stroke: 2 }, { d: "M8.6 9.6l2.8 2.4-2.8 2.4M12.6 14.6h3", stroke: 2 }],
      omp: [{ d: "M5.2 5.5h13.6a1.2 1.2 0 0 1 0 3.2H5.2a1.2 1.2 0 0 1 0-3.2zM8.6 7h.8a1.2 1.2 0 0 1 1.2 1.2v9.6a1.2 1.2 0 0 1-1.2 1.2h-.8a1.2 1.2 0 0 1-1.2-1.2V8.2A1.2 1.2 0 0 1 8.6 7zM13.4 7h3.2v9.4c0 .9.4 1.3 1.3 1.3h1.1V20h-1.8c-2.5 0-3.8-1.2-3.8-3.6z", fill: true }],
      other: [{ d: "M6 8l4 4-4 4M12 17h6", stroke: 2.2 }],
    };
    const paths: Record<string, { p: Path2D; stroke?: number; fill?: boolean }[]> = {};
    for (const [k, parts] of Object.entries(GLYPHS)) paths[k] = parts.map((x) => ({ ...x, p: new Path2D(x.d) }));

    type Actor = { x: number; y: number; kind: "agent" | "person"; glyph: string; tint: number; ring: number };
    type Msg = { from: number; to: number; t0: number; phase: "in" | "out"; dur: number; person: boolean };
    type Block = { born: number; person: boolean };

    let W = 0;
    let H = 0;
    let dpr = 1;
    let fx0 = 0;
    let fx1 = 0;
    let recY = 0;
    let headX = 0;
    let small = false;
    let actors: Actor[] = [];
    let msgs: Msg[] = [];
    let blocks: Block[] = [];
    let shiftFrom = 0; // when the record last moved one place to the left
    let seq = 212;
    let nextSend = 0;
    let turn = 0;
    let colors: Record<string, string> = {};

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function readColors() {
      const cs = getComputedStyle(document.documentElement);
      const v = (n: string) => cs.getPropertyValue(n).trim();
      colors = {
        line: v("--grid") || "#ebebe5",
        faint: v("--faint"),
        muted: v("--muted"),
        ink: v("--ink"),
        onInk: v("--on-ink"),
        rule: v("--rule"),
        accent: v("--accent"),
        accentLine: v("--accent-strong"),
        bg: v("--background"),
      };
      for (const i of [2, 3, 5, 7]) {
        colors[`t${i}b`] = v(`--id-${i}-bg`);
        colors[`t${i}f`] = v(`--id-${i}-fg`);
      }
    }

    function layout() {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width;
      H = rect.height;
      small = W < 760;
      const frame = canvas.closest(".frame")?.getBoundingClientRect();
      fx0 = frame ? frame.left - rect.left : 0;
      fx1 = frame ? frame.right - rect.left : W;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      // The record sits in the hero's bottom margin, on a grid line when one is near.
      recY = Math.round(H - 26) + 0.5;
      headX = Math.round(W / 2);

      // Members sit on grid crossings beside the text: as close to the text as the
      // column allows, and never inside it.
      const clear = Math.min(W * 0.74, 960);
      const leftEdge = (W - clear) / 2;
      const rows = Math.floor((H - 70) / CELL);
      const leftCols: number[] = [];
      const rightCols: number[] = [];
      for (let c = 1; c * CELL < W; c++) {
        const x = c * CELL;
        if (x < fx0 + 28 || x > fx1 - 28) continue;
        if (x < leftEdge - 26) leftCols.push(c);
        if (x > W - leftEdge + 26) rightCols.push(c);
      }
      actors = [];
      if (!small && leftCols.length && rightCols.length && rows >= 6) {
        const l1 = leftCols[leftCols.length - 1];
        const l2 = leftCols[Math.max(0, leftCols.length - 3)];
        const r1 = rightCols[0];
        const r2 = rightCols[Math.min(rightCols.length - 1, 2)];
        const at = (c: number, r: number) => ({ x: c * CELL, y: Math.min(r, rows) * CELL });
        actors = [
          { ...at(l1, 2), kind: "agent", glyph: "cc", tint: 2, ring: -1e9 },
          { ...at(l2, 5), kind: "agent", glyph: "omp", tint: 3, ring: -1e9 },
          { ...at(r1, 3), kind: "agent", glyph: "cx", tint: 5, ring: -1e9 },
          { ...at(r2, 6), kind: "person", glyph: "", tint: 0, ring: -1e9 },
          { ...at(rightCols.length > 1 ? r1 : r2, 7), kind: "agent", glyph: "other", tint: 7, ring: -1e9 },
        ];
        // Two members on one crossing would hide each other.
        actors = actors.filter((a, i) => actors.findIndex((b) => b.x === a.x && b.y === a.y) === i);
      }
      // A record already under way: still frames and first paint show it written.
      const n = Math.ceil(headX / SP) + 2;
      blocks = Array.from({ length: n }, (_, i) => ({ born: -1e9, person: i % 5 === 2 }));
      msgs = [];
      shiftFrom = -1e9;
    }

    // A message's route: along its member's column to the record line, then along the
    // line to the head; on the way out, the same in reverse to the recipient.
    function route(a: Actor | null, out: boolean, side: number): [number, number][] {
      if (!a) {
        const edge = side < 0 ? Math.max(fx0, 0) : Math.min(fx1, W);
        return out ? [[headX, recY], [edge, recY]] : [[edge, recY], [headX, recY]];
      }
      const pts: [number, number][] = [[a.x, a.y], [a.x, recY], [headX, recY]];
      return out ? pts.reverse() : pts;
    }
    function along(pts: [number, number][], t: number): [number, number] {
      let total = 0;
      const segs = pts.slice(1).map((p, i) => {
        const l = Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]);
        total += l;
        return l;
      });
      let d = t * total;
      for (let i = 0; i < segs.length; i++) {
        if (d <= segs[i] || i === segs.length - 1) {
          const k = segs[i] ? clamp(d / segs[i]) : 1;
          return [pts[i][0] + (pts[i + 1][0] - pts[i][0]) * k, pts[i][1] + (pts[i + 1][1] - pts[i][1]) * k];
        }
        d -= segs[i];
      }
      return pts[pts.length - 1];
    }

    function send(now: number) {
      turn++;
      if (actors.length < 2) {
        msgs.push({ from: turn % 2 ? -1 : -2, to: turn % 2 ? -2 : -1, t0: now, phase: "in", dur: 2200, person: false });
        return;
      }
      const person = actors.findIndex((a) => a.kind === "person");
      // Every fourth message is the person steering; the rest are agents talking.
      let from: number;
      if (turn % 4 === 0 && person >= 0) from = person;
      else {
        const agents = actors.map((_, i) => i).filter((i) => i !== person);
        from = agents[turn % agents.length];
      }
      const others = actors.map((_, i) => i).filter((i) => i !== from && (from === person || i !== person || turn % 3 === 0));
      const to = others[(turn * 7) % others.length];
      const a = actors[from];
      const dist = Math.abs(a.y - recY) + Math.abs(a.x - headX);
      msgs.push({ from, to, t0: now, phase: "in", dur: clamp(dist * 2.6, 1400, 2600), person: from === person });
    }

    function step(now: number) {
      if (now >= nextSend) {
        send(now);
        nextSend = now + 2600 + Math.random() * 1400;
      }
      for (const m of msgs) {
        if (now - m.t0 < m.dur) continue;
        if (m.phase === "in") {
          blocks.unshift({ born: now, person: m.person });
          blocks.length = Math.ceil(headX / SP) + 2;
          shiftFrom = now;
          seq++;
          const to = actors[m.to];
          m.phase = "out";
          m.t0 = now + 380;
          m.dur = to ? clamp((Math.abs(to.y - recY) + Math.abs(to.x - headX)) * 2.4, 1300, 2400) : 2000;
        } else {
          const to = actors[m.to];
          if (to) to.ring = now;
          m.dur = -1;
        }
      }
      msgs = msgs.filter((m) => m.dur >= 0);
    }

    // Grid lines fade towards the centre and the bottom, as before, so the text sits on
    // a clear page.
    function gridAlpha(x: number, y: number) {
      const dx = Math.abs(x - W / 2) / (W / 2);
      if (small) return clamp(1 - y / (H * 0.3)) * 0.8;
      return clamp((dx - 0.25) / 0.4) * clamp(1 - (y / H - 0.6) / 0.4);
    }

    function drawGrid() {
      const c = ctx!;
      c.lineWidth = 1;
      c.strokeStyle = colors.line;
      const inFrame = (x: number) => x >= fx0 - 1 && x <= fx1 + 1;
      for (let x = 0; x <= W; x += CELL) {
        if (!inFrame(x)) continue;
        for (let y = 0; y < H; y += CELL) {
          const a = gridAlpha(x, y + CELL / 2);
          if (a <= 0.02) continue;
          c.globalAlpha = a;
          c.beginPath();
          c.moveTo(x + 0.5, y);
          c.lineTo(x + 0.5, y + CELL);
          c.stroke();
        }
      }
      for (let y = 0; y <= H; y += CELL) {
        for (let x = 0; x < W; x += CELL) {
          if (!inFrame(x) || !inFrame(x + CELL)) continue;
          const a = gridAlpha(x + CELL / 2, y);
          if (a <= 0.02) continue;
          c.globalAlpha = a;
          c.beginPath();
          c.moveTo(x, y + 0.5);
          c.lineTo(x + CELL, y + 0.5);
          c.stroke();
        }
      }
    }

    function roundRect(x: number, y: number, w: number, h: number, r: number) {
      const c = ctx!;
      c.beginPath();
      c.moveTo(x + r, y);
      c.arcTo(x + w, y, x + w, y + h, r);
      c.arcTo(x + w, y + h, x, y + h, r);
      c.arcTo(x, y + h, x, y, r);
      c.arcTo(x, y, x + w, y, r);
      c.closePath();
    }

    function drawActor(a: Actor, now: number) {
      const c = ctx!;
      const s = 28;
      // The route each member uses, as a quiet rule down to the record.
      c.globalAlpha = 0.5;
      c.strokeStyle = colors.rule;
      c.setLineDash([2, 4]);
      c.lineWidth = 1;
      c.beginPath();
      c.moveTo(a.x + 0.5, a.y + s / 2 + 4);
      c.lineTo(a.x + 0.5, recY);
      c.stroke();
      c.setLineDash([]);
      // An arrival ring.
      const rt = (now - a.ring) / 900;
      if (rt >= 0 && rt < 1) {
        c.globalAlpha = (1 - rt) * 0.7;
        c.strokeStyle = a.kind === "person" ? colors.accentLine : colors.ink;
        c.lineWidth = 1.25;
        roundRect(a.x - s / 2 - 3 - rt * 7, a.y - s / 2 - 3 - rt * 7, s + 6 + rt * 14, s + 6 + rt * 14, 9 + rt * 4);
        c.stroke();
      }
      c.globalAlpha = 0.92;
      if (a.kind === "person") {
        c.fillStyle = colors.ink;
        c.beginPath();
        c.arc(a.x, a.y, s / 2, 0, Math.PI * 2);
        c.fill();
        c.fillStyle = colors.onInk;
        c.font = '600 12px "Geist", ui-sans-serif, sans-serif';
        c.textAlign = "center";
        c.textBaseline = "middle";
        c.fillText("you", a.x, a.y + 0.5);
        return;
      }
      c.fillStyle = colors[`t${a.tint}b`];
      roundRect(a.x - s / 2, a.y - s / 2, s, s, 8);
      c.fill();
      c.save();
      c.translate(a.x - 8.5, a.y - 8.5);
      c.scale(17 / 24, 17 / 24);
      c.strokeStyle = c.fillStyle = colors[`t${a.tint}f`];
      c.lineCap = "round";
      c.lineJoin = "round";
      for (const part of paths[a.glyph]) {
        if (part.fill) c.fill(part.p);
        else {
          c.lineWidth = part.stroke ?? 2;
          c.stroke(part.p);
        }
      }
      c.restore();
    }

    function drawRecord(now: number) {
      const c = ctx!;
      // The line the record is written on: solid where it is written, faint ahead.
      const fadeL = Math.max(fx0, 0);
      const grad = c.createLinearGradient(fadeL, 0, Math.min(fx1, W), 0);
      grad.addColorStop(0, "transparent");
      grad.addColorStop(0.18, colors.rule);
      grad.addColorStop(0.82, colors.rule);
      grad.addColorStop(1, "transparent");
      c.globalAlpha = 1;
      c.strokeStyle = grad;
      c.lineWidth = 1;
      c.beginPath();
      c.moveTo(fadeL, recY);
      c.lineTo(Math.min(fx1, W), recY);
      c.stroke();

      // The blocks slide one place left as a new one is appended at the head.
      const shift = 1 - easeOut(clamp((now - shiftFrom) / 650));
      for (let i = blocks.length - 1; i >= 0; i--) {
        const b = blocks[i];
        const x = headX - (i - shift) * SP;
        const y = recY;
        const fade = clamp(1 - (headX - x) / Math.max(1, headX - fadeL)) ** 1.4;
        if (fade <= 0.02) continue;
        // The link to the block before.
        if (i < blocks.length - 1) {
          c.globalAlpha = fade * 0.9;
          c.strokeStyle = colors.faint;
          c.lineWidth = 1;
          c.beginPath();
          c.moveTo(x - SP + BLOCK / 2, y);
          c.lineTo(x - BLOCK / 2, y);
          c.stroke();
        }
        const age = clamp((now - b.born) / 2200);
        const fresh = 1 - easeOut(age);
        const appear = clamp((now - b.born) / 260);
        const size = BLOCK * (0.6 + 0.4 * easeOut(appear));
        c.globalAlpha = fade * (0.55 + 0.45 * fresh) * appear;
        c.fillStyle = b.person ? colors.ink : colors.bg;
        roundRect(x - size / 2, y - size / 2, size, size, 2.5);
        c.fill();
        c.strokeStyle = colors.faint;
        c.lineWidth = 1;
        c.stroke();
        if (fresh > 0.01) {
          c.globalAlpha = fade * fresh;
          c.fillStyle = colors.accent;
          roundRect(x - size / 2, y - size / 2, size, size, 2.5);
          c.fill();
        }
        if (i === 0) {
          // The head, marked as the record marks it, with its sequence number.
          c.globalAlpha = 1;
          c.strokeStyle = colors.accentLine;
          c.lineWidth = 1.25;
          roundRect(x - BLOCK / 2 - 3, y - BLOCK / 2 - 3, BLOCK + 6, BLOCK + 6, 4);
          c.stroke();
          c.globalAlpha = 0.9;
          c.fillStyle = colors.muted;
          c.font = '500 10.5px "Geist Mono", ui-monospace, monospace';
          c.textAlign = "left";
          c.textBaseline = "middle";
          c.fillText(`#${seq}`, x + BLOCK / 2 + 9, y + 0.5);
        }
      }
    }

    function drawMessages(now: number) {
      const c = ctx!;
      for (const m of msgs) {
        const t = (now - m.t0) / m.dur;
        if (t < 0 || t > 1) continue;
        const a = m.phase === "in" ? actors[m.from] ?? null : actors[m.to] ?? null;
        const side = (m.phase === "in" ? m.from : m.to) === -1 ? -1 : 1;
        const pts = route(a, m.phase === "out", side);
        const e = easeInOut(t);
        const [x, y] = along(pts, e);
        const [tx, ty] = along(pts, Math.max(0, e - 0.07));
        const col = m.person ? colors.accentLine : colors.ink;
        c.globalAlpha = 0.35;
        c.strokeStyle = m.person ? colors.accent : colors.ink;
        c.lineWidth = 2;
        c.lineCap = "round";
        c.beginPath();
        c.moveTo(tx, ty);
        c.lineTo(x, y);
        c.stroke();
        c.globalAlpha = 0.9;
        c.fillStyle = m.person ? colors.accent : col;
        c.beginPath();
        c.arc(x, y, 3, 0, Math.PI * 2);
        c.fill();
      }
    }

    function draw(now: number) {
      const c = ctx!;
      c.clearRect(0, 0, W, H);
      drawGrid();
      for (const a of actors) drawActor(a, now);
      drawRecord(now);
      drawMessages(now);
      c.globalAlpha = 1;
    }

    let running = false;
    let visible = true;
    let last = 0;
    function frame(now: number) {
      if (!running) return;
      if (now - last > 30) {
        step(now);
        draw(now);
        last = now;
      }
      requestAnimationFrame(frame);
    }
    function update() {
      const should = visible && !document.hidden && !reduced.matches;
      if (should && !running) {
        running = true;
        nextSend = Math.max(nextSend, performance.now() + 700);
        requestAnimationFrame(frame);
      } else if (!should) {
        running = false;
        draw(performance.now());
      }
    }

    readColors();
    layout();
    draw(performance.now());
    new ResizeObserver(() => {
      layout();
      draw(performance.now());
    }).observe(canvas);
    new IntersectionObserver((e) => {
      visible = e.some((x) => x.isIntersecting);
      update();
    }).observe(canvas);
    document.addEventListener("visibilitychange", update);
    reduced.addEventListener("change", update);
    const repaint = () => {
      readColors();
      draw(performance.now());
    };
    new MutationObserver(repaint).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", repaint);
    document.fonts?.ready.then(repaint);
    update();
  }
</script>
