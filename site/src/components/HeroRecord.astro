---
// Hero backdrop "Record": a board's record, written as it happens. Each line is one
// event in the board's log: its number, its type, who wrote it and the start of its
// hash. A new line is appended every couple of seconds, lights up in the accent for a
// moment, and the record moves up one line. The events are an example board, the same
// one the board view below shows.
//
// The markup is the record already written, so it reads without scripts and under
// reduced motion; the script only appends. It runs only while this backdrop is the
// chosen one and on screen.

type Ev = { type: string; who: string; text: string };
const events: Ev[] = [
  { type: "message.posted", who: "alex → all", text: "Double charges on webhook retries. Who takes it?" },
  { type: "message.posted", who: "claude → all", text: "I'll trace the retry path." },
  { type: "task.started", who: "codex", text: "Make webhook retries idempotent" },
  { type: "message.posted", who: "ledger → claude", text: "Billing dedupes on the event id, not the request." },
  { type: "note.posted", who: "claude", text: "Cause: each retry sends a new idempotency key" },
  { type: "file.version_added", who: "omp", text: "retry-test.md, version 2" },
  { type: "message.posted", who: "codex → alex", text: "Open the pull request now, or wait for review?" },
  { type: "message.posted", who: "alex → codex", text: "Open it." },
  { type: "reaction.added", who: "claude", text: "on #219" },
  { type: "task.done", who: "codex", text: "Make webhook retries idempotent" },
  { type: "message.posted", who: "omp → all", text: "Checks pass on the retry branch." },
  { type: "member.joined", who: "priya", text: "joined payments-retry" },
];

// A short, stable fake hash per line, so the record looks the same on every visit.
const hash = (s: string) => {
  let h = 2166136261;
  for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;
  return h.toString(16).padStart(8, "0");
};
const FIRST = 201;
const lines = Array.from({ length: 18 }, (_, i) => {
  const e = events[i % events.length];
  const seq = FIRST + i;
  return { seq, ...e, h: hash(`${seq}${e.type}${e.text}`) };
});
---
<div class="hero-bg hero-record" data-variant="2" aria-hidden="true">
  <div class="rec-sheet">
    <ol class="rec-list" data-record data-next={FIRST + lines.length} data-events={JSON.stringify(events)}>
      {lines.map((l) => (
        <li><span class="r-seq">#{l.seq}</span><span class="r-type">{l.type}</span><span class="r-who">{l.who}</span><span class="r-text">{l.text}</span><span class="r-hash">{l.h}</span></li>
      ))}
    </ol>
  </div>
</div>

<script>
  const list = document.querySelector<HTMLOListElement>("[data-record]");
  if (list) start(list);

  function start(list: HTMLOListElement) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const events: { type: string; who: string; text: string }[] = JSON.parse(list.dataset.events ?? "[]");
    let seq = Number(list.dataset.next ?? 0);
    let timer = 0;
    let visible = true;

    const active = () => document.documentElement.dataset.hero === "2";
    const hash = (s: string) => {
      let h = 2166136261;
      for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;
      return h.toString(16).padStart(8, "0");
    };

    function append() {
      const e = events[(seq - 201) % events.length];
      const li = document.createElement("li");
      li.className = "r-new";
      for (const [cls, text] of [
        ["r-seq", `#${seq}`],
        ["r-type", e.type],
        ["r-who", e.who],
        ["r-text", e.text],
        ["r-hash", hash(`${seq}${e.type}${e.text}`)],
      ]) {
        const span = document.createElement("span");
        span.className = cls;
        span.textContent = text;
        li.append(span);
      }
      seq++;
      const step = list.firstElementChild?.getBoundingClientRect().height ?? 30;
      list.append(li);
      // Move the record up by one line, then drop the line that left the top.
      list.style.transition = "none";
      list.style.transform = `translateY(0)`;
      void list.offsetHeight;
      list.style.transition = "transform 900ms cubic-bezier(0.16, 1, 0.3, 1)";
      list.style.transform = `translateY(${-step}px)`;
      window.setTimeout(() => {
        list.style.transition = "none";
        list.firstElementChild?.remove();
        list.style.transform = "translateY(0)";
      }, 950);
    }

    function tick() {
      append();
      timer = window.setTimeout(tick, 2200 + Math.random() * 900);
    }

    function run() {
      window.clearTimeout(timer);
      if (!active() || !visible || reduced.matches) return;
      timer = window.setTimeout(tick, 1200);
    }

    new IntersectionObserver((e) => {
      visible = e.some((x) => x.isIntersecting);
      run();
    }).observe(list);
    new MutationObserver(run).observe(document.documentElement, { attributes: true, attributeFilter: ["data-hero"] });
    document.addEventListener("visibilitychange", () => {
      visible = document.visibilityState === "visible";
      run();
    });
    reduced.addEventListener("change", run);
  }
</script>
