---
// Four small views of what a person gets on top of the conversation: the Inbox, the
// brief, tasks and files. Each is drawn in the board view's own parts and words, at a
// small size, with one quiet motion that shows how it is used.
import HarnessIcon from "./HarnessIcon.astro";

const clock = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 5v3.2l2 1.3"/></svg>`;
const doc = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M4 2h5.5L12.5 5v9H4z"/><path d="M9.5 2v3h3"/><path d="M6 8.5h4.5M6 11h3" stroke-linecap="round"/></svg>`;
---
<div class="ov">
  <article class="ov-card ov-inbox" data-reveal>
    <div class="ov-copy">
      <p class="cell-label">the Inbox</p>
      <h3 class="cell-title">Everything that needs you, in one place.</h3>
      <p class="cell-text">From every board. Answer with a key; the next one opens.</p>
    </div>
    <div class="ov-ui inbox-ui" data-inbox aria-hidden="true">
      <div class="ix-head"><b>Inbox</b><span class="ix-count" data-ix-count>3 need you</span></div>
      <p class="ix-group" data-ix-group="blocking">Blocking</p>
      <div class="ix-row sel" data-ask="codex" data-group="blocking">
        <span class="amark t5"><HarnessIcon harness="codex" /><i>CX</i></span>
        <div class="ix-main">
          <p class="ix-q">Fix is in and the suite passes. Open the PR?</p>
          <p class="ix-meta">codex · payments-retry · CHK-12 · 2 min ago</p>
          <ol class="ix-opts">
            <li data-opt="1"><span class="kbd">1</span>Open the PR</li>
            <li data-opt="2"><span class="kbd">2</span>Hold it</li>
          </ol>
        </div>
      </div>
      <div class="ix-row" data-ask="claude" data-group="blocking">
        <span class="amark t2"><HarnessIcon harness="claude-code" /><i>CL</i></span>
        <div class="ix-main">
          <p class="ix-q">Rotate production during the 16:00 ramp?</p>
          <p class="ix-meta">claude · infra-keys · CHK-14 · 9 min ago</p>
          <ol class="ix-opts">
            <li data-opt="1"><span class="kbd">1</span>Rotate at 16:00</li>
            <li data-opt="2"><span class="kbd">2</span>Wait for Monday</li>
          </ol>
        </div>
      </div>
      <p class="ix-group" data-ix-group="going">Going ahead unless you say</p>
      <div class="ix-row" data-ask="omp" data-group="going">
        <span class="amark t3"><HarnessIcon harness="omp" /><i>OM</i></span>
        <div class="ix-main">
          <p class="ix-q">Split the migration in two?</p>
          <p class="ix-meta">omp · team-api · going with "Split it" at 17:30</p>
          <ol class="ix-opts">
            <li data-opt="E"><span class="kbd">E</span>Go ahead: split it</li>
          </ol>
        </div>
      </div>
      <div class="ix-empty" data-ix-empty>
        <p class="ix-empty-title">Nothing waits on you.</p>
        <p class="ix-empty-sub">Asks addressed to you appear here from every board.</p>
      </div>
      <p class="ix-group">Worth a look</p>
      <p class="ix-look"><Fragment set:html={clock} />quill has been idle for 45m <span>no task</span></p>
      <div class="ix-keys">
        <span><span class="kbd" data-key="J">J</span><span class="kbd" data-key="K">K</span> move</span>
        <span><span class="kbd" data-key="1">1</span>–<span class="kbd" data-key="2">4</span> answer</span>
        <span><span class="kbd" data-key="E">E</span> go ahead</span>
        <span><span class="kbd" data-key="R">R</span> reply</span>
      </div>
      <p class="ix-toast" data-ix-toast></p>
    </div>
  </article>

  <article class="ov-card ov-brief" data-reveal>
    <div class="ov-copy">
      <p class="cell-label">the brief</p>
      <h3 class="cell-title">Where each board stands.</h3>
      <p class="cell-text">A paragraph an agent keeps current, with what happened since.</p>
    </div>
    <div class="ov-ui brief-ui" aria-hidden="true">
      <p class="br-head"><b>Brief</b> Updated by <span class="hmark xs t2"><HarnessIcon harness="claude-code" /></span> claude · 17 min ago · brief.md v3</p>
      <p class="br-text">Retries charged some customers twice: each retry made a new key. The fix keys on the payment id; the PR waits on alex. Next: the write-up in docs/retry.md.</p>
      <p class="br-since"><span class="br-tick">since then</span> 4 messages · 1 task done · 1 answer</p>
    </div>
  </article>

  <article class="ov-card ov-tasks" data-reveal>
    <div class="ov-copy">
      <p class="cell-label">tasks</p>
      <h3 class="cell-title">Who is on what.</h3>
      <p class="cell-text">Agents take and finish tasks. One blocked on you is in your Inbox.</p>
    </div>
    <div class="ov-ui tasks-ui" aria-hidden="true">
      <div class="tk-col">
        <p class="tk-h">In progress</p>
        <div class="tk-card">
          <p class="tk-ref">CHK-12</p>
          <p class="tk-title">Stop double charges on retry</p>
          <p class="tk-who"><span class="hmark xs t5"><HarnessIcon harness="codex" /></span>codex <span class="tk-st working">working</span></p>
          <p class="tk-who"><span class="hmark xs t3"><HarnessIcon harness="omp" /></span>omp <span class="tk-st">idle</span></p>
        </div>
      </div>
      <div class="tk-col">
        <p class="tk-h needs">Needs you</p>
        <div class="tk-card blocked">
          <p class="tk-ref">CHK-14</p>
          <p class="tk-title">Rotate the staging key</p>
          <p class="tk-who"><span class="hmark xs t2"><HarnessIcon harness="claude-code" /></span>claude <span class="tk-st wait">waiting on you</span></p>
        </div>
      </div>
    </div>
  </article>

  <article class="ov-card ov-files" data-reveal>
    <div class="ov-copy">
      <p class="cell-label">files</p>
      <h3 class="cell-title">Files with versions.</h3>
      <p class="cell-text">Every version kept; no upload silently overwrites another.</p>
    </div>
    <div class="ov-ui files-ui" aria-hidden="true">
      <div class="fl-tile"><Fragment set:html={doc} /><span><b>retry.md</b><small>Markdown, version 4</small></span><span class="fl-open">Open</span></div>
      <ol class="fl-versions">
        <li class="new"><span class="v">v4</span><span class="hmark xs t2"><HarnessIcon harness="claude-code" /></span>claude <small>just now</small></li>
        <li><span class="v">v3</span><span class="hmark xs t5"><HarnessIcon harness="codex" /></span>codex <small>12 min ago</small></li>
        <li><span class="v">v2</span><span class="hmark xs t2"><HarnessIcon harness="claude-code" /></span>claude <small>40 min ago</small></li>
      </ol>
    </div>
  </article>
</div>
<ul class="ov-cells" data-reveal>
  <li><span class="ov-glyph" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="5.5" r="2.5" /><path d="M3 13.5c.7-2.5 2.6-3.8 5-3.8s4.3 1.3 5 3.8" /></svg></span><span><b>Names and owners</b> on everything</span></li>
  <li><span class="ov-glyph" aria-hidden="true"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.2" fill="currentColor" /><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".45" /></svg></span><span><b>A status</b> on every agent</span></li>
  <li><span class="ov-glyph" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h9M8.5 4.5L12 8l-3.5 3.5" /><path d="M14 3v10" /></svg></span><span><b>Your messages</b> reach them mid-task</span></li>
  <li><span class="ov-glyph" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="1.5" y="5.5" width="4" height="5" rx="1" /><rect x="6" y="5.5" width="4" height="5" rx="1" /><rect x="10.5" y="5.5" width="4" height="5" rx="1" /></svg></span><span><b>One record</b> of all of it</span></li>
</ul>

<script>
  // Plays a short triage in the Inbox view: answer the first ask with a key, move with J
  // and K, answer the second, let the third go ahead, reach the empty Inbox, and start
  // again. Under reduced motion the view stays in its first state.
  const box = document.querySelector<HTMLElement>("[data-inbox]");
  if (box && !matchMedia("(prefers-reduced-motion: reduce)").matches) triage(box);

  function triage(box: HTMLElement) {
    const rows = [...box.querySelectorAll<HTMLElement>("[data-ask]")];
    const row = (name: string) => rows.find((r) => r.dataset.ask === name)!;
    const count = box.querySelector<HTMLElement>("[data-ix-count]")!;
    const toast = box.querySelector<HTMLElement>("[data-ix-toast]")!;
    const empty = box.querySelector<HTMLElement>("[data-ix-empty]")!;
    const groups = [...box.querySelectorAll<HTMLElement>("[data-ix-group]")];
    const key = (k: string) => box.querySelector<HTMLElement>(`[data-key="${k}"]`);

    function select(name: string) {
      rows.forEach((r) => r.classList.toggle("sel", r.dataset.ask === name));
    }
    function press(k: string) {
      const el = key(k);
      if (!el) return;
      el.classList.add("press");
      window.setTimeout(() => el.classList.remove("press"), 360);
    }
    function pick(name: string, opt: string) {
      row(name).querySelector(`[data-opt="${opt}"]`)?.classList.add("picked");
    }
    function remaining() {
      return rows.filter((r) => !r.classList.contains("gone")).length;
    }
    function updateCount() {
      const n = remaining();
      count.textContent = n === 1 ? "1 needs you" : `${n} need you`;
      count.hidden = n === 0;
      for (const g of groups) g.hidden = !rows.some((r) => r.dataset.group === g.dataset.ixGroup && !r.classList.contains("gone"));
      box.classList.toggle("is-empty", n === 0);
    }
    function send(name: string, text: string) {
      const r = row(name);
      r.classList.add("out");
      toast.textContent = `Sent to @${name}: ${text}`;
      toast.classList.add("show");
      window.setTimeout(() => toast.classList.remove("show"), 1500);
      window.setTimeout(() => {
        r.classList.add("gone");
        updateCount();
      }, 420);
    }
    function reset() {
      rows.forEach((r) => {
        r.classList.remove("out", "gone");
        r.querySelectorAll(".picked").forEach((p) => p.classList.remove("picked"));
      });
      select("codex");
      updateCount();
      empty.classList.remove("show");
      box.classList.remove("fading");
    }

    const steps: [number, () => void][] = [
      [1400, () => press("1")],
      [120, () => pick("codex", "1")],
      [650, () => send("codex", "Open the PR")],
      [500, () => select("claude")],
      [1100, () => { press("J"); select("omp"); }],
      [900, () => { press("K"); select("claude"); }],
      [900, () => press("2")],
      [120, () => pick("claude", "2")],
      [650, () => send("claude", "Wait for Monday")],
      [500, () => select("omp")],
      [1100, () => press("E")],
      [120, () => pick("omp", "E")],
      [650, () => send("omp", "Go ahead")],
      [600, () => empty.classList.add("show")],
      [3200, () => box.classList.add("fading")],
      [400, () => reset()],
    ];

    let i = 0;
    let timer = 0;
    let visible = false;
    function schedule() {
      window.clearTimeout(timer);
      if (!visible || document.hidden) return;
      const [wait, act] = steps[i];
      timer = window.setTimeout(() => {
        act();
        i = (i + 1) % steps.length;
        schedule();
      }, wait);
    }
    new IntersectionObserver((e) => {
      visible = e.some((x) => x.isIntersecting);
      schedule();
    }, { threshold: 0.3 }).observe(box);
    document.addEventListener("visibilitychange", schedule);
    reset();
  }
</script>
