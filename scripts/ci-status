#!/bin/sh
# Says whether the check workflow (.github/workflows/check.yml) passed on one commit.
# The release workflow uses it as its gate, and scripts/land-pr uses it on the head it
# is about to merge.
#
#   scripts/ci-status --event push|pull_request [--branch <name>] [--wait <seconds>]
#                     [--expect] <commit-sha>
#
# Only a run that tested exactly that commit counts. GitHub indexes a run by its head
# commit, but which tree a run checked out depends on the event, so the caller names
# the event and this script checks every run it considers:
#
#   - its event is the one given: "push" for a commit pushed to a branch (the release
#     gate asks for --branch main), "pull_request" for a pull request's head, which
#     check.yml checks out by its exact commit rather than GitHub's merge with main;
#   - its head commit is the commit asked about;
#   - with --branch, its branch is the one given;
#   - it ran in this repository on this repository's code, not from a fork.
#
# The newest run that qualifies decides, at its latest attempt (a rerun of failed jobs
# replaces the result), and it passes only when every job in it passed.
#
# It prints one line, "<result> <run url>". The result is "success", the conclusion of a
# run that didn't pass (failure, cancelled, timed_out, ...), "pending" for a run still
# going when the wait ran out, or "missing" (with "-" for the address) when the commit
# has no run that qualifies.
#
# Options:
#
#   --event <event>   the event the run must be for: push or pull_request (required)
#   --branch <name>   the branch the run must be for
#   --wait <seconds>  wait up to this long while the run is queued or running (default 0)
#   --expect          the commit was just pushed, so its run is on its way: wait for the
#                     run to appear as well, within the same time
#
# Exit codes:
#
#   0  the run passed
#   1  usage error, or gh couldn't list the runs
#   2  the run finished without passing
#   3  the commit has no run that qualifies
#   4  the run was still going when the wait ran out
#
# Environment:
#
#   CI_STATUS_WORKFLOW  the workflow file to look at (default check.yml)
#   CI_STATUS_INTERVAL  seconds between looks while waiting (default 30)
#   GH_REPO             the repository (owner/name), when not run in a clone of it
set -eu

say() { printf '%s\n' "$*"; }
usage() {
	say "usage: scripts/ci-status --event push|pull_request [--branch <name>] [--wait <seconds>] [--expect] <commit-sha>" >&2
	exit 1
}

wait_for=0
expect=no
event=
branch=
sha=
while [ $# -gt 0 ]; do
	case $1 in
	--wait | --event | --branch)
		[ $# -ge 2 ] || usage
		case $1 in
		--wait) wait_for=$2 ;;
		--event) event=$2 ;;
		--branch) branch=$2 ;;
		esac
		shift
		;;
	--expect) expect=yes ;;
	-h | --help) usage ;;
	-*) usage ;;
	*)
		[ -z "$sha" ] || usage
		sha=$1
		;;
	esac
	shift
done
case $wait_for in
'' | *[!0-9]*) usage ;;
esac
case $event in
push | pull_request) ;;
*) usage ;;
esac
# GitHub matches runs by the full commit id only.
case $sha in
*[!0-9a-f]*) usage ;;
esac
[ ${#sha} -eq 40 ] || usage

workflow=${CI_STATUS_WORKFLOW:-check.yml}
interval=${CI_STATUS_INTERVAL:-30}
command -v gh >/dev/null 2>&1 || {
	say "ci-status: gh isn't installed; install GitHub's CLI and run gh auth login" >&2
	exit 1
}

query="head_sha=$sha&event=$event&per_page=30"
[ -z "$branch" ] || query="$query&branch=$branch"
# One line per run, newest first. The filters above are GitHub's; the checks below
# don't rely on them.
fields='.workflow_runs[] | "\(.event) \(.head_branch) \(.head_sha) \(.head_repository.full_name // "-") \(.repository.full_name) \(.run_attempt) \(.status) \(.conclusion // "-") \(.html_url)"'

start=$(date +%s)
while :; do
	runs=$(gh api "repos/{owner}/{repo}/actions/workflows/$workflow/runs?$query" --jq "$fields") || {
		say "ci-status: can't list the $workflow runs for $sha with gh; check gh auth status" >&2
		exit 1
	}
	url=- status=missing conclusion=- attempt=
	while read -r r_event r_branch r_sha r_head_repo r_repo r_attempt r_status r_conclusion r_url; do
		[ "$r_event" = "$event" ] || continue
		[ "$r_sha" = "$sha" ] || continue
		[ -z "$branch" ] || [ "$r_branch" = "$branch" ] || continue
		[ "$r_head_repo" = "$r_repo" ] || continue
		url=$r_url status=$r_status conclusion=$r_conclusion attempt=$r_attempt
		break
	done <<EOF
$runs
EOF
	if [ "$status" = completed ]; then
		if [ "$conclusion" = success ]; then
			say "success $url"
			exit 0
		fi
		[ "$conclusion" != - ] || conclusion=unknown
		say "$conclusion $url"
		exit 2
	fi
	elapsed=$(($(date +%s) - start))
	if [ "$elapsed" -ge "$wait_for" ] || { [ "$status" = missing ] && [ "$expect" = no ]; }; then
		if [ "$status" = missing ]; then
			say "missing -"
			exit 3
		fi
		say "pending $url"
		exit 4
	fi
	if [ "$status" = missing ]; then
		say "ci-status: no $event run of $workflow for $sha yet; looking again in ${interval}s" >&2
	else
		say "ci-status: $workflow is $status on $sha (attempt $attempt, $url); looking again in ${interval}s" >&2
	fi
	sleep "$interval"
done
