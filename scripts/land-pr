#!/bin/sh
# Lands a pull request once its checks pass: brings the PR's branch up to date with main,
# makes sure GitHub's check workflow passed on the exact commit it will merge (or runs
# the checks here with --local), runs the live tests CI can't run when asked, merges the
# PR on GitHub and cleans up what it set up. It never switches branches, pulls or commits
# in the main checkout.
#
#   scripts/land-pr [--dry-run] [--live] [--local] <pr-number>
#   scripts/land-pr --classify < changed-paths
#
# Steps:
#
#   1. Ask GitHub (gh) for the PR's branch; the PR must be open, from this repository,
#      and into main.
#   2. Use the worktree that already has that branch checked out, or create a temporary
#      one at .claude/worktrees/land-pr-<number> in the main checkout.
#   3. Merge origin/main into the branch. On a conflict, stop and name the files.
#   4. The checks. By default CI is the gate: if the check workflow (check.yml, every
#      job) already passed on the branch's head after step 3, nothing runs here. If it
#      has no result for that commit yet, the script pushes it and waits for CI, up to
#      LAND_PR_CI_WAIT seconds; a run that fails stops the landing. With --local, the
#      script runs the checks here instead, by what changed against origin/main:
#        only design/ or engineering/   no code checks
#        anything else                  make fmt-check lint vet generate-check harness-table-check
#                                       test e2e
#        web/ too                       make web-check as well
#      A change to delivery, setup or upgrades also gets a note that make live must pass
#      before merging (classify below lists the paths). With --live, the script runs
#      make live-affected, which needs harness logins and so can't run in CI, and
#      merges only if it passes. While CI runs, the live tests run beside it.
#   5. Push the branch, merge the PR with a merge commit at exactly the checked commit,
#      and confirm GitHub reports it MERGED. Right before each attempt, and after a
#      refused one, fetch main: if the head no longer contains it, don't merge; start
#      again from step 3, so the new main is merged and the new head checked (at most
#      three rounds, then exit 4 with nothing merged). If main didn't move, a refused
#      merge is retried. A small window remains between that check and the merge, in
#      which main can still move; only GitHub's "require branches to be up to date"
#      rule on main closes it, and that rule isn't on yet (engineering/release.md).
#   6. Only after a confirmed merge: remove the worktree and local branch if this script
#      created them, and delete the branch on GitHub.
#
# Options:
#
#   --dry-run    print the plan (worktree, predicted conflicts, checks) and change
#                nothing except fetching from origin
#   --live       also run make live-affected, and merge only if it passes
#   --local      run the checks here rather than relying on CI
#   --classify   read changed paths on standard input and print the checks --local runs
#                for them, one line per item ("make <targets>", "live-note"), then exit
#
# Exit codes:
#
#   0  merged and cleaned up (or the dry-run plan or classification was printed)
#   1  usage error, a missing tool, or a PR or worktree this script won't touch
#   2  merging main into the branch conflicted; the merge is left in the worktree
#   3  a check failed, here or in CI; the log's path or the run's address is printed
#   4  pushing or merging failed; nothing was cleaned up
#   5  merged, but some cleanup failed; what is left is printed
#   6  CI hadn't finished on the branch's head within LAND_PR_CI_WAIT; the branch is
#      pushed, so run the script again later
#
# Environment:
#
#   LAND_PR_MERGE_TRAILER  a line added at the end of the merge-main commit message,
#                          such as a Co-Authored-By trailer
#   LAND_PR_RETRY_DELAY    seconds between merge attempts (default 5)
#   LAND_PR_CI_WAIT        seconds to wait for CI on the branch's head (default 1800)
#   CI_STATUS_INTERVAL     seconds between looks at CI while waiting (default 30)
set -eu

code_checks="fmt-check lint vet generate-check harness-table-check test e2e"
merge_attempts=5
max_rounds=3
script_dir=$(cd "$(dirname "$0")" && pwd)
self="$script_dir/$(basename "$0")"
ci_status="$script_dir/ci-status"
# The arguments, for starting again when main moves (they hold no spaces).
args="$*"

say() { printf '%s\n' "$*"; }
fail() {
	status=$1
	shift
	printf 'land-pr: %s\n' "$*" >&2
	exit "$status"
}

usage() {
	say "usage: scripts/land-pr [--dry-run] [--live] [--local] <pr-number>" >&2
	say "       scripts/land-pr --classify < changed-paths" >&2
	exit 1
}

# classify reads changed paths on standard input and prints what they call for:
# "make <targets>" when code checks run, and "live-note" when delivery, setup or
# upgrades changed. It prints nothing for a change to only design/ and engineering/.
classify() {
	code=no
	web=no
	live=no
	any=no
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		any=yes
		case $path in
		design/* | engineering/*) ;;
		web/*)
			code=yes
			web=yes
			;;
		*) code=yes ;;
		esac
		case $path in
		*_test.go) ;;
		# Delivery, then setup (init, doctor, the install manifest, the launchers), then
		# upgrades (aboard upgrade, the release it reads, the update notice, the install
		# script).
		server/internal/delivery/* | server/internal/harness/* | adapters/* | skills/* | \
			server/internal/cli/daemon.go | server/internal/cli/delivery*.go | \
			server/internal/cli/hook.go | \
			server/internal/cli/init*.go | server/internal/cli/doctor.go | \
			server/internal/cli/installed.go | server/internal/cli/manifest.go | \
			server/internal/cli/uninstall.go | server/internal/cli/launch.go | \
			server/internal/launcher/* | launchers/* | \
			server/internal/cli/outdated.go | server/internal/cli/upgrade.go | \
			server/internal/cli/selfupgrade.go | server/internal/cli/release.go | \
			server/internal/cli/updatenotice.go | scripts/install.sh)
			live=yes
			;;
		esac
	done
	[ "$any" = yes ] || return 0
	if [ "$code" = yes ]; then
		if [ "$web" = yes ]; then
			say "make $code_checks web-check"
		else
			say "make $code_checks"
		fi
	fi
	if [ "$live" = yes ]; then
		say "live-note"
	fi
}

# explain prints, for a classification, what will run and why.
explain() {
	plan=$1
	make_line=$(printf '%s\n' "$plan" | grep '^make ' || true)
	if [ "$mode" = ci ]; then
		say "Checks: the check workflow on GitHub, which must pass on the exact commit this"
		say "  merges; nothing runs here (--local runs the checks here instead)."
	elif [ -z "$make_line" ]; then
		say "Checks: none, because the branch changes only design/ and engineering/ (or nothing)."
	else
		why="the branch changes files outside design/ and engineering/"
		case $make_line in
		*web-check*) why="$why, including web/" ;;
		esac
		say "Checks: $make_line"
		say "  because $why."
	fi
	if printf '%s\n' "$plan" | grep -q '^live-note$'; then
		say "Note: this changes delivery, setup or upgrades. The definition of done needs"
		if [ "$live" = yes ]; then
			say "  make live to pass before merging; --live runs make live-affected here."
		else
			say "  make live (or make live-affected) to pass before merging, which CI can't"
			say "  run; this script runs it only with --live."
		fi
	fi
}

dry_run=no
live=no
mode=ci
pr=
while [ $# -gt 0 ]; do
	case $1 in
	--dry-run) dry_run=yes ;;
	--live) live=yes ;;
	--local) mode=local ;;
	--classify)
		[ $# -eq 1 ] || usage
		classify
		exit 0
		;;
	-h | --help) usage ;;
	-*) usage ;;
	*)
		[ -z "$pr" ] || usage
		pr=$1
		;;
	esac
	shift
done
case $pr in
'' | *[!0-9]*) usage ;;
esac

command -v gh >/dev/null 2>&1 || fail 1 "gh isn't installed; install GitHub's CLI and run gh auth login"
command -v git >/dev/null 2>&1 || fail 1 "git isn't installed"

common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
	fail 1 "run this inside the repository (any worktree of it)"
main_root=$(dirname "$common_dir")
[ -d "$main_root/.git" ] || fail 1 "can't find the main checkout from $common_dir"
temp_wt="$main_root/.claude/worktrees/land-pr-$pr"

info=$(gh pr view "$pr" --json state,headRefName,baseRefName,isCrossRepository,url \
	--jq '"\(.state) \(.headRefName) \(.baseRefName) \(.isCrossRepository) \(.url)"') ||
	fail 1 "can't read PR #$pr with gh; check the number and gh auth status"
# shellcheck disable=SC2086 # the fields have no spaces
set -- $info
state=$1 branch=$2 base=$3 cross=$4 url=$5
say "PR #$pr: $url"
say "Branch: $branch"
[ "$state" = OPEN ] || fail 1 "PR #$pr is $state, not open; nothing to land"
[ "$base" = main ] || fail 1 "PR #$pr goes into $base; this script lands PRs into main only"
[ "$cross" = false ] || fail 1 "PR #$pr comes from a fork; land it by hand"

say "Fetching origin..."
git fetch -q origin main "+refs/heads/$branch:refs/remotes/origin/$branch" ||
	fail 1 "can't fetch main and $branch from origin"

# Find the worktree that has the branch checked out, if any.
existing_wt=$(git worktree list --porcelain | awk -v ref="refs/heads/$branch" '
	/^worktree / { wt = substr($0, 10) }
	$0 == "branch " ref { print wt; exit }')

if [ "$existing_wt" = "$main_root" ]; then
	fail 1 "the main checkout ($main_root) has $branch checked out, and it should stay on main; switch it back to main yourself if nothing there is in progress, then run this again"
fi

local_exists=no
git show-ref --verify --quiet "refs/heads/$branch" && local_exists=yes

if [ "$dry_run" = yes ]; then
	if [ -n "$existing_wt" ]; then
		say "Worktree: $existing_wt (already has $branch; it would be used and kept)"
		head_ref=$(git -C "$existing_wt" rev-parse HEAD)
		if [ -n "$(git -C "$existing_wt" status --porcelain)" ]; then
			say "  It has uncommitted changes, so a real run would stop there."
		fi
	elif [ "$local_exists" = yes ]; then
		say "Worktree: would create $temp_wt for the existing local branch $branch, and remove it after merging (the branch would be kept)"
		head_ref=refs/heads/$branch
	else
		say "Worktree: would create $temp_wt with a new local branch $branch, and remove both after merging"
		head_ref=refs/remotes/origin/$branch
	fi
	if git merge-base --is-ancestor origin/main "$head_ref"; then
		say "Main: the branch already has origin/main"
	elif conflicts=$(git merge-tree --write-tree --name-only origin/main "$head_ref" 2>/dev/null); then
		say "Main: would merge origin/main into the branch; it merges cleanly"
	else
		say "Main: merging origin/main would conflict in:"
		printf '%s\n' "$conflicts" | sed -n '2,/^$/p' | sed '/^$/d; s/^/  /'
	fi
	plan=$(git diff --name-only "origin/main...$head_ref" | classify)
	explain "$plan"
	if [ "$mode" = ci ]; then
		if git merge-base --is-ancestor origin/main "$head_ref"; then
			ci_out=$("$ci_status" --event pull_request "$(git rev-parse "$head_ref")" 2>/dev/null) || true
			case $ci_out in
			success*) say "CI: passed on the branch's head (${ci_out#* }); a real run merges without waiting." ;;
			missing* | pending*) say "CI: no result on the branch's head yet; a real run pushes it and waits for CI." ;;
			'') say "CI: can't read the check workflow's runs with gh; a real run would stop there." ;;
			*) say "CI: ${ci_out%% *} on the branch's head (${ci_out#* }); a real run stops there." ;;
			esac
		else
			say "CI: a real run pushes the merge with main and waits for CI on it."
		fi
	fi
	if [ "$live" = yes ]; then
		say "Live: a real run runs make live-affected, and merges only if it passes."
	fi
	say "Then: push $branch, gh pr merge $pr --merge, confirm MERGED, clean up, delete origin/$branch."
	say "Dry run: nothing changed."
	exit 0
fi

# Set up the worktree.
created_wt=no
created_branch=no
if [ -n "$existing_wt" ]; then
	wt=$existing_wt
	git_dir=$(git -C "$wt" rev-parse --absolute-git-dir)
	# A worktree a previous run of this script created is still this script's to remove.
	[ -f "$git_dir/land-pr-created-worktree" ] && created_wt=yes
	[ -f "$git_dir/land-pr-created-branch" ] && created_branch=yes
	say "Worktree: $wt (already had $branch)"
	if [ -n "$(git -C "$wt" status --porcelain)" ]; then
		fail 1 "$wt has uncommitted changes or an unfinished merge; commit them (or finish the merge) and run this again"
	fi
else
	[ ! -e "$temp_wt" ] || fail 1 "$temp_wt exists but doesn't have $branch checked out; remove it (git worktree remove $temp_wt) and run this again"
	mkdir -p "$(dirname "$temp_wt")"
	if [ "$local_exists" = yes ]; then
		git worktree add -q "$temp_wt" "$branch" || fail 1 "can't create a worktree for $branch at $temp_wt"
	else
		git worktree add -q --track -b "$branch" "$temp_wt" "origin/$branch" ||
			fail 1 "can't create a worktree for $branch at $temp_wt"
		created_branch=yes
	fi
	created_wt=yes
	wt=$temp_wt
	git_dir=$(git -C "$wt" rev-parse --absolute-git-dir)
	: >"$git_dir/land-pr-created-worktree"
	[ "$created_branch" = no ] || : >"$git_dir/land-pr-created-branch"
	say "Worktree: created $wt"
fi
cd "$wt"

# Catch up with anything pushed to the branch that the worktree doesn't have.
if ! git merge-base --is-ancestor "origin/$branch" HEAD; then
	if git merge-base --is-ancestor HEAD "origin/$branch"; then
		git merge -q --ff-only "origin/$branch"
		say "Branch: fast-forwarded to origin/$branch"
	else
		fail 1 "$branch in $wt and origin/$branch have both moved on; reconcile them there and run this again"
	fi
fi

# Merge main.
if git merge-base --is-ancestor origin/main HEAD; then
	say "Main: the branch already has origin/main"
else
	msg="Merge main into $branch"
	if [ -n "${LAND_PR_MERGE_TRAILER:-}" ]; then
		set -- -m "$msg" -m "$LAND_PR_MERGE_TRAILER"
	else
		set -- -m "$msg"
	fi
	if ! git merge -q --no-edit "$@" origin/main >/dev/null 2>&1; then
		say "Main: merging origin/main into $branch conflicts in:" >&2
		git diff --name-only --diff-filter=U | sed 's/^/  /' >&2
		fail 2 "the merge is left in progress in $wt: resolve the files and commit, then run scripts/land-pr $pr again (or git merge --abort there to give up)"
	fi
	say "Main: merged origin/main into $branch"
fi

# ci_failed stops the landing for a check workflow run that didn't pass.
ci_failed() {
	say "CI: the check workflow ended with ${1%% *} on $(git rev-parse --short HEAD): ${1#* }" >&2
	fail 3 "if the change caused it, fix it in $wt, commit, and run scripts/land-pr $pr again. If the same test fails on unchanged main, it's a known flake (engineering/testing.md): rerun the failed jobs (gh run rerun --failed <run id>) and run this again"
}

# Run the checks.
plan=$(git diff --name-only origin/main...HEAD | classify)
explain "$plan"
head_sha=$(git rev-parse HEAD)
ci_wait=no
if [ "$mode" = ci ]; then
	ci_code=0
	ci_out=$("$ci_status" --event pull_request "$head_sha") || ci_code=$?
	case $ci_code in
	0) say "CI: passed on $(git rev-parse --short HEAD) (${ci_out#* })" ;;
	2) ci_failed "$ci_out" ;;
	3 | 4)
		# Start CI on this exact commit now, so it runs beside the live tests.
		git push -q origin "HEAD:refs/heads/$branch" ||
			fail 4 "can't push $branch for CI to run on; if someone else pushed to it, run scripts/land-pr $pr again. Nothing was merged or cleaned up"
		say "Pushed: $branch at $(git rev-parse --short HEAD), for CI to run on"
		ci_wait=yes
		;;
	*) fail 1 "can't read the check workflow's runs with gh (above); check gh auth status, or run the checks here with --local" ;;
	esac
else
	make_line=$(printf '%s\n' "$plan" | grep '^make ' || true)
	if [ -n "$make_line" ]; then
		log="${TMPDIR:-/tmp}"
		log="${log%/}/land-pr-$pr.log"
		say "Running: $make_line (in $wt; output in $log)"
		# shellcheck disable=SC2086 # make_line is "make" and target names, no spaces inside
		if ! $make_line >"$log" 2>&1; then
			say "Checks failed. Lines that look like the failure:" >&2
			grep -E -- '--- FAIL|^FAIL|Error|error:|\*\*\*' "$log" | head -20 | sed 's/^/  /' >&2 || true
			fail 3 "fix the failure in $wt, commit, and run scripts/land-pr --local $pr again; full output in $log"
		fi
		say "Checks passed."
	fi
fi
if [ "$live" = yes ]; then
	live_log="${TMPDIR:-/tmp}"
	live_log="${live_log%/}/land-pr-$pr-live.log"
	say "Running: make live-affected (in $wt; output in $live_log)"
	if ! make live-affected >"$live_log" 2>&1; then
		say "Live tests failed. Lines that look like the failure:" >&2
		grep -E -- '--- FAIL|^FAIL|  fail  |\*\*\*' "$live_log" | head -20 | sed 's/^/  /' >&2 || true
		fail 3 "fix the failure in $wt, commit, and run scripts/land-pr --live $pr again; full output in $live_log"
	fi
	say "Live tests passed."
fi
if [ "$ci_wait" = yes ]; then
	ci_limit=${LAND_PR_CI_WAIT:-1800}
	say "CI: waiting up to $((ci_limit / 60)) min for the check workflow on $(git rev-parse --short HEAD)"
	ci_code=0
	ci_out=$("$ci_status" --event pull_request --wait "$ci_limit" --expect "$head_sha") || ci_code=$?
	case $ci_code in
	0) say "CI: passed (${ci_out#* })" ;;
	2) ci_failed "$ci_out" ;;
	3 | 4) fail 6 "CI hasn't finished on $(git rev-parse --short HEAD) after $((ci_limit / 60)) min (${ci_out#* }); $branch is pushed, so run scripts/land-pr $pr again later" ;;
	*) fail 1 "can't read the check workflow's runs with gh (above); check gh auth status, or run the checks here with --local" ;;
	esac
fi

# Push and merge.
git push -q origin "HEAD:refs/heads/$branch" ||
	fail 4 "can't push $branch; if someone else pushed to it, run scripts/land-pr $pr again. Nothing was merged or cleaned up"
say "Pushed: $branch at $(git rev-parse --short HEAD)"

# again_if_main_moved starts over when origin's main has a commit the checked head
# lacks, merging the new main and checking the new head. It runs right before every
# merge attempt, since GitHub may accept a merge of a stale head, and after a refused
# one. It fails closed: if main can't be fetched, or keeps moving, nothing merges. It
# narrows the window for a stale merge but can't close it, since main can move between
# this check and the merge; only the "require branches to be up to date" rule does.
again_if_main_moved() {
	git fetch -q origin main ||
		fail 4 "can't fetch main from origin to check the head still contains it, so nothing was merged; $branch is pushed and $wt is kept. Run scripts/land-pr $pr again"
	git merge-base --is-ancestor origin/main "$head_sha" && return 0
	round=${LAND_PR_ROUND:-1}
	[ "$round" -lt "$max_rounds" ] ||
		fail 4 "main moved during each of $max_rounds tries to land PR #$pr, so nothing was merged; $branch is pushed and $wt is kept. Run scripts/land-pr $pr again"
	say "Main moved to $(git rev-parse --short origin/main) while landing; starting again to merge it and check the new head ($((round + 1)) of $max_rounds)"
	# shellcheck disable=SC2086 # args are options and a number, no spaces inside
	LAND_PR_ROUND=$((round + 1)) exec "$self" $args
}

delay=${LAND_PR_RETRY_DELAY:-5}
attempt=1
merged=no
while [ "$attempt" -le "$merge_attempts" ]; do
	again_if_main_moved
	out=$(gh pr merge "$pr" --merge --match-head-commit "$head_sha" 2>&1) || true
	if [ "$(gh pr view "$pr" --json state --jq .state 2>/dev/null)" = MERGED ]; then
		merged=yes
		break
	fi
	again_if_main_moved
	case $out in
	*"ase branch was modified"*)
		say "GitHub says the base branch was modified; trying again in ${delay}s ($attempt of $merge_attempts)"
		sleep "$delay"
		;;
	*)
		printf '%s\n' "$out" | sed 's/^/  /' >&2
		fail 4 "gh pr merge failed (above). $branch is pushed and the worktree $wt is kept; fix the cause and run gh pr merge $pr --merge, or run scripts/land-pr $pr again"
		;;
	esac
	attempt=$((attempt + 1))
done
[ "$merged" = yes ] ||
	fail 4 "PR #$pr isn't merged after $merge_attempts attempts; $branch is pushed and $wt is kept. Run scripts/land-pr $pr again"
say "Merged: PR #$pr"

# Clean up only after GitHub confirms the merge.
cd "$main_root"
left=
if [ "$created_wt" = yes ]; then
	if git worktree remove "$wt" 2>/dev/null; then
		say "Removed the worktree $wt"
	else
		left="$left
  the worktree $wt has files git doesn't ignore; look, then git worktree remove --force $wt"
	fi
else
	say "Kept the worktree $wt (this script didn't create it)"
fi
if [ "$created_branch" = yes ]; then
	if [ -n "$(git worktree list --porcelain | grep -Fx "branch refs/heads/$branch" || true)" ]; then
		left="$left
  the local branch $branch, still checked out in $wt"
	elif [ "$(git rev-parse "refs/heads/$branch")" != "$head_sha" ]; then
		left="$left
  the local branch $branch, which has commits that weren't merged"
	else
		git branch -q -D "$branch"
		say "Deleted the local branch $branch"
	fi
fi
if git push -q origin --delete "$branch" 2>/dev/null; then
	say "Deleted origin/$branch"
else
	left="$left
  origin/$branch: git push origin --delete $branch"
fi
git fetch -q origin main || true
say "origin/main is now $(git log --oneline -1 origin/main)"
if [ -n "$left" ]; then
	say "Left in place:$left" >&2
	exit 5
fi
