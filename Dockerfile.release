# The aboard team server image the release job publishes to GHCR. It holds the release's
# own binary, with the board view embedded: GoReleaser puts each platform's binary in
# the build context at <os>/<arch>/aboard, and this copies the one for the platform being
# built. To build the image from source instead, use the Dockerfile next to this one;
# both run the server the same way.
#
#   docker run -v aboard-data:/data -p 127.0.0.1:7400:7400 \
#     -e ABOARD_PUBLIC_URL=https://aboard.example.com ghcr.io/leonidas1712/aboard:<version>

# A small image with a shell, so an operator can read the first admin's key file with
# kubectl exec or docker exec.
FROM alpine:3.22
ARG TARGETPLATFORM
RUN addgroup -S -g 10001 aboard && adduser -S -D -H -u 10001 -G aboard -h /data aboard \
 && mkdir -p /data && chown aboard:aboard /data && chmod 700 /data
COPY $TARGETPLATFORM/aboard /usr/local/bin/aboard
USER 10001:10001
ENV ABOARD_DATA=/data/aboard ABOARD_LISTEN=0.0.0.0:7400 ABOARD_NO_UPDATE_CHECK=1
VOLUME /data
EXPOSE 7400
ENTRYPOINT ["aboard", "serve", "--team"]
