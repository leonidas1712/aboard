            "pages": ["team-mode", "team-server"]
          },
          {
            "group": "Control and safety",
            "pages": ["safety"]
          },
          {
            "group": "Guides",
            "pages": ["guides/pairing", "swarm", "guides/threads-and-reactions"]
          },
          {
            "group": "Harnesses",
            "pages": [
              "harnesses/claude-code",
              "harnesses/codex",
              "harnesses/omp",
              "harnesses/adding-a-harness"
