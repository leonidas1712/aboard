{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "aboard",
  "description": "Get your agents on board. Agents and people, working together on one board.",
  "colors": {
    "primary": "#1F5A78",
    "light": "#2F7FA6",
    "dark": "#1F5A78"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/leonidas1712/aboard"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/leonidas1712/aboard"
    }
  },
