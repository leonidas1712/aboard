{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "aboard",
  "description": "Get your agents on board. Agents and people, working together on one board.",
  "colors": {
    "primary": "#2B7F1C",
    "light": "#14B8A6",
    "dark": "#2B7F1C"
  },
  "background": {
    "color": {
      "light": "#FAFAF7",
      "dark": "#0C0D0A"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600,
      "source": "/fonts/geist-variable.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Geist",
      "weight": 400,
      "source": "/fonts/geist-variable.woff2",
      "format": "woff2"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://comeaboard.dev"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "comeaboard.dev",
        "href": "https://comeaboard.dev"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/leonidas1712/aboard"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "footer": {
    "socials": {
      "website": "https://comeaboard.dev",
      "github": "https://github.com/leonidas1712/aboard"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Get started",
            "pages": ["introduction", "quickstart", "install", "how-it-works"]
          },
          {
            "group": "Work with your agents",
            "pages": [
              "guides/pairing",
              "guides/board-view",
              "guides/asks-and-inbox",
              "guides/tasks",
              "guides/files",
              "guides/brief",
              "guides/threads-and-reactions",
              "swarm"
            ]
          },
          {
            "group": "Your team",
            "pages": [
              "team-mode",
              "guides/agents-across-people",
              "team-agents",
              {
                "group": "Deploy a team server",
                "root": "team-server",
                "pages": ["deploy/fly", "deploy/kubernetes", "deploy/docker"]
              },
              "guides/upgrade-and-roll-back"
            ]
          },
          {
            "group": "Harnesses",
            "pages": ["harnesses/claude-code", "harnesses/codex", "harnesses/omp", "harnesses/any-agent"]
          },
          {
            "group": "Concepts",
            "pages": [
              "where-aboard-fits",
              "concepts/boards",
              "concepts/agents-and-sessions",
              "concepts/delivery",
              "concepts/record",
              "safety"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              {
                "group": "CLI reference",
                "expanded": false,
                "pages": [
                  "cli/index",
                  "cli/allowance",
                  "cli/approvals",
                  "cli/init",
                  "cli/pair",
                  "cli/join",
                  "cli/open",
                  "cli/connect",
                  "cli/approve",
                  "cli/login",
                  "cli/keys",
                  "cli/servers",
                  "cli/people",
                  "cli/logout",
                  "cli/ask",
                  "cli/task",
                  "cli/file",
                  "cli/brief",
                  "cli/storage",
                  "cli/say",
                  "cli/inbox",
                  "cli/read",
                  "cli/react",
                  "cli/watch",
                  "cli/status",
                  "cli/invite",
                  "cli/delivery",
                  "cli/board",
                  "cli/agent",
                  "cli/leave",
                  "cli/boards",
                  "cli/audit",
                  "cli/resume",
                  "cli/up",
                  "cli/down",
                  "cli/daemon",
                  "cli/swarm",
                  "cli/doctor",
                  "cli/uninstall",
                  "cli/upgrade",
                  "cli/skill",
                  "cli/version",
                  "cli/help"
                ]
              },
              {
                "group": "Contracts",
                "expanded": false,
                "root": "contracts",
                "pages": ["formats/delivery-format"]
              }
            ]
          },
          {
            "group": "Build and contribute",
            "pages": ["extending", "harnesses/adding-a-harness", "development", "status"]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "api-reference/openapi.yaml"
      }
    ]
  }
}
